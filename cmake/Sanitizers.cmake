# Sanitizer flags. ASan and UBSan combine; TSan must run alone.
function(corebank_enable_sanitizers target)
  set(_flags "")
  if(COREBANK_ENABLE_TSAN AND (COREBANK_ENABLE_ASAN OR COREBANK_ENABLE_UBSAN))
    message(FATAL_ERROR "ThreadSanitizer cannot be combined with ASan/UBSan")
  endif()
  if(COREBANK_ENABLE_ASAN)
    list(APPEND _flags -fsanitize=address -fno-omit-frame-pointer)
  endif()
  if(COREBANK_ENABLE_UBSAN)
    list(APPEND _flags -fsanitize=undefined -fno-sanitize-recover=all -fno-omit-frame-pointer)
  endif()
  if(COREBANK_ENABLE_TSAN)
    list(APPEND _flags -fsanitize=thread -fno-omit-frame-pointer)
  endif()
  if(COREBANK_ENABLE_COVERAGE)
    list(APPEND _flags --coverage -O0 -g)
  endif()
  if(_flags)
    target_compile_options(${target} PRIVATE ${_flags})
    target_link_options(${target} PRIVATE ${_flags})
  endif()
endfunction()
