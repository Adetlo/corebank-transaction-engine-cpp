    Priority: 1
  - Regex: '^<(gtest|gmock)/'
    Priority: 2
  - Regex: '^<sqlite3\.h>'
    Priority: 3
  - Regex: '^<.*\.h>'
    Priority: 4
  - Regex: '^<.*'
    Priority: 5
SortIncludes: CaseSensitive
